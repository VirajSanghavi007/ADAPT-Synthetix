{
  "name": "Mercury - Retrain Threshold Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT COUNT(*) FROM asr_logs WHERE created_at > COALESCE((SELECT value_timestamp FROM training_marker WHERE key = 'last_trained_at'), '1970-01-01')) AS new_asr_samples,\n  (SELECT COUNT(*) FROM tts_logs WHERE created_at > COALESCE((SELECT value_timestamp FROM training_marker WHERE key = 'last_trained_at'), '1970-01-01')) AS new_tts_samples;",
        "options": {}
      },
      "id": "postgres-count",
      "name": "Count New Samples",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "mercury-postgres",
          "name": "Mercury Local Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-threshold",
              "leftValue": "={{ $json.new_asr_samples }}",
              "rightValue": 500,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-threshold",
      "name": "Threshold Reached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RETRAIN_NOTIFY_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: \"retrain_threshold_reached\", new_asr_samples: $json.new_asr_samples, new_tts_samples: $json.new_tts_samples, checked_at: $now.toISO() }) }}",
        "options": {}
      },
      "id": "notify-webhook",
      "name": "Notify (Slack/Email webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO training_marker (key, value_timestamp)\nVALUES ('last_notified_at', NOW())\nON CONFLICT (key) DO UPDATE SET value_timestamp = NOW();",
        "options": {}
      },
      "id": "postgres-mark-notified",
      "name": "Mark Notified",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1120, 200],
      "credentials": {
        "postgres": {
          "id": "mercury-postgres",
          "name": "Mercury Local Postgres"
        }
      }
    },
    {
      "parameters": {},
      "id": "noop-below-threshold",
      "name": "Below Threshold",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Count New Samples",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Count New Samples": {
      "main": [
        [
          {
            "node": "Threshold Reached?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Threshold Reached?": {
      "main": [
        [
          {
            "node": "Notify (Slack/Email webhook)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Below Threshold",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify (Slack/Email webhook)": {
      "main": [
        [
          {
            "node": "Mark Notified",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "mercury-local"
  }
}
