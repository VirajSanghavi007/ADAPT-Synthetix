# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default). Set USE_POSTGRES=true and DATABASE_URL for PostgreSQL.
USE_POSTGRES=false
DATABASE_URL=postgresql://adapt:adapt@db:5432/adaptsynthetix

# ── Paths (override only if you move data outside the repo) ────────────────────
DB_DIR=
DB_PATH=
DATASET_DIR=
RAW_AUDIO_DIR=
REMEDIAL_AUDIO_DIR=
LOGS_DIR=
MODELS_DIR=
TEMP_DIR=
FRONTEND_DIR=

# ── HuggingFace model cache ────────────────────────────────────────────────────
TRANSFORMERS_CACHE=/app/.cache/huggingface
HF_HOME=/app/.cache/huggingface

# ── App ────────────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
