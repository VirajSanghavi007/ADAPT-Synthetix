# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default). Set USE_POSTGRES=true and DATABASE_URL for PostgreSQL.
USE_POSTGRES=false
DATABASE_URL=postgresql://adapt:adapt@db:5432/adaptsynthetix

# ── Paths (override only if you move data outside the repo) ────────────────────
DB_DIR=
DB_PATH=
DATASET_DIR=
RAW_AUDIO_DIR=
REMEDIAL_AUDIO_DIR=
LOGS_DIR=
MODELS_DIR=
TEMP_DIR=
FRONTEND_DIR=

# ── HuggingFace model cache ────────────────────────────────────────────────────
TRANSFORMERS_CACHE=/app/.cache/huggingface
HF_HOME=/app/.cache/huggingface

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# REQUIRED when AUTH_ENABLED=true — server refuses to start if these are missing.
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
# Must match exactly what you add in Google Cloud Console → Authorized redirect URIs
AUTH_REDIRECT_URI=http://localhost:5000/auth/callback
# REQUIRED: Random 32+ char secret for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The server will refuse to start if this is not set.
AUTH_SECRET_KEY=<generate-with-secrets-token-hex-32>
# Set false to skip auth in local dev (GOOGLE_CLIENT_ID/SECRET not required when false)
AUTH_ENABLED=true
# REQUIRED: Owner backdoor key — triple-click the dot top-right on the login page.
# The server will refuse to start if this is not set.
BACKDOOR_KEY=<strong-random-value>

# ── App ────────────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
# Days to retain uploaded audio files before cleanup (default: 30)
AUDIO_RETENTION_DAYS=30
