# --- Database ---
# Supabase session pooler (project ojqxzojribpmknxxjije, region ap-southeast-1).
# Get the password from Supabase dashboard -> Project Settings -> Database. Never commit it.
# Leave unset to fall back to a local SQLite file (used automatically on HF Spaces if no DB is attached)
DATABASE_URL=postgresql://postgres.ojqxzojribpmknxxjije:%5BPUT-YOUR-PASSWORD%5D@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Supabase (auth) ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://ojqxzojribpmknxxjije.supabase.co
# service_role key — backend-only, never expose to the frontend. Rotate if ever pasted in chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (passkeys / WebAuthn) ---
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=
# Must match the domain the frontend is served from (no scheme, no port for RP_ID)
RP_ID=localhost
ORIGIN=http://localhost:8000

# --- CORS ---
CORS_ORIGINS=http://localhost:8000

# --- Model Spaces ---
# This backend proxies all ASR/TTS to 3 HF Spaces (see spaces/space-free|pro|max/),
# never loads a model itself. SPACE_SECRET must match the same value set on each Space.
SPACE_FREE_URL=https://your-username-mercury-space-free.hf.space
SPACE_PRO_URL=https://your-username-mercury-space-pro.hf.space
SPACE_MAX_URL=https://your-username-mercury-space-max.hf.space
SPACE_SECRET=

# --- Transactional email (account deletion confirmation) ---
# Leave SMTP_HOST unset in dev — the delete-request endpoint returns the confirm
# link directly in its response instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@mercury.app

# --- Cron-triggered internal endpoints (n8n calls these, not real users) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# --- Environment ---
# Set to "production" when deployed (enables Secure cookie flag — requires HTTPS)
ENV=development
