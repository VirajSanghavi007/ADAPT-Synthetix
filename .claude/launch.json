{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/Frontend",
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "${workspaceFolder}/venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "Backend.main:app",
        "--host", "0.0.0.0", "--port", "8000", "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "port": 8000
    }
  ]
}
